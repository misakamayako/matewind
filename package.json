    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^0.11.6",
    "globals": "^15.15.0",
    "less": "^4.4.0",
    "postcss": "^8.5.6",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.4.1"
